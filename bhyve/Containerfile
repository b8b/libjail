ARG BASE_IMAGE=freebsd-minimal:15.1-RELEASE-p6
FROM ${BASE_IMAGE} as espadm

ARG ESP_SIZE_MIB=64

ADD espadm /usr/src/espadm

RUN pkg install -y \
        FreeBSD-kernel-generic \
        FreeBSD-bootloader \
        FreeBSD-set-devel \
        FreeBSD-zstd \
        rust && \
    ( cd /usr/src/espadm && cargo build --release && install -m 755 target/release/espadm /bin/espadm ) && \
    pkg delete -y \
        FreeBSD-set-devel \
        FreeBSD-zstd \
        rust && \
    pkg autoremove -y && \
    pkg clean -y && \
    rm -Rf /var/cache/pkg /var/db/pkg/repos /usr/src/espadm/target

RUN mkdir -p /boot/efi/EFI/BOOT /boot/efi/boot/kernel && \
    loader=/boot/loader.efi; \
    [ -f "$loader" ] || loader=/boot/loader_lua.efi; \
    ln "$loader" /boot/efi/EFI/BOOT/BOOTX64.EFI && \
    cp -r /boot/defaults /boot/loader.conf.d /boot/fonts /boot/lua /boot/efi/boot/ && \
    gzip < /boot/kernel/kernel > /boot/efi/boot/kernel/kernel.gz && \
    for mod in zfs opensolaris mac_do netgraph ng_socket ng_bridge ng_eiface ng_bpf; \
        do gzip < /boot/kernel/"$mod".ko > /boot/efi/boot/kernel/"$mod".ko.gz; done

ADD loader.conf /boot/efi/boot/loader.conf

RUN esp_offset="$((1024 * 1024))"; \
    esp_size="$((1024 * 1024 * ${ESP_SIZE_MIB}))"; \
    mkimg -s gpt \
      -p "efi/efiboot0::$esp_size:$esp_offset" \
      -o disk0.img && \
    espadm --image disk0.img --source /boot/efi && \
    tar caf /disk0.tar.zst disk0.img && \
    rm -f disk0.img

FROM ${BASE_IMAGE}

RUN pkg install -y \
        FreeBSD-acpi \
        FreeBSD-pf \
        FreeBSD-zstd \
        FreeBSD-zfs \
        FreeBSD-ufs \
        FreeBSD-pam \
        FreeBSD-ssh && \
        mkdir -p /boot/efi /root/.ssh && \
        touch /etc/fstab /etc/rc.conf && \
        pw useradd -n freebsd -m -u 1001 -g staff -G wheel \
            -d /home/freebsd -s /bin/sh -w no && \
        mkdir -p /home/freebsd/.ssh && \
        touch /home/freebsd/.ssh/authorized_keys &&\
        chown -R freebsd:wheel /home/freebsd/.ssh && \
        tar -C / -cf - --format mtree --one-file-system \
            --exclude var/cache/pkg \
            --exclude var/db/pkg/repos \
            --exclude root.mtree \
            --exclude disk0.img \
            --exclude disk1.img \
            --exclude disk2.img \
            --exclude 'efi.*' \
            --exclude cidata \
            --exclude '.save-*' \
            --exclude run.sh \
            --exclude root.mtree \
            . | awk '{ gsub(/ nlink=[0-9]+/, ""); print }' > /root.mtree && \
        pkg install -y \
        FreeBSD-bhyve \
        bhyve-firmware \
        edk2-bhyve \
        grub2-bhyve \
        socat \
        dnsmasq && \
        pkg clean -y && \
        rm -Rf /var/cache/pkg /var/db/pkg/repos

COPY --from=espadm /disk0.tar.zst /
COPY --from=espadm /bin/espadm /bin/

ADD run.sh /run.sh

RUN chmod 755 /run.sh

CMD ["/run.sh"]
